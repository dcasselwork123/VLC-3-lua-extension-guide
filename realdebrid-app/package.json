{
  "name": "realdebrid-streamer",
  "version": "1.0.0",
  "description": "Netflix-style torrent streaming with Real Debrid",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "build:win": "electron-builder --win --x64",
    "pack": "electron-builder --dir"
  },
  "keywords": ["realdebrid", "torrent", "streaming", "netflix"],
  "author": "Real Debrid Streamer",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.6.0",
    "electron-store": "^8.1.0"
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.0"
  },
  "build": {
    "appId": "com.realdebrid.streamer",
    "productName": "Real Debrid Streamer",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": ["portable"],
      "icon": "assets/icon.png"
    },
    "portable": {
      "artifactName": "RealDebridStreamer-Portable.exe"
    },
    "files": [
      "**/*",
      "!dist",
      "!node_modules"
    ]
  }
}
