{
  "name": "realdebrid-streamer",
  "version": "1.0.0",
  "description": "Netflix-style torrent streaming with Real Debrid",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "build:win": "electron-builder --win --x64",
    "build:installer": "electron-builder --win --x64 nsis",
    "pack": "electron-builder --dir"
  },
  "keywords": ["realdebrid", "torrent", "streaming", "netflix"],
  "author": "Real Debrid Streamer",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.6.0"
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.0"
  },
  "build": {
    "appId": "com.realdebrid.streamer",
    "productName": "Real Debrid Streamer",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        },
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ],
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Real Debrid Streamer",
      "artifactName": "RealDebridStreamer-Setup-${version}.exe"
    },
    "portable": {
      "artifactName": "RealDebridStreamer-Portable.exe"
    },
    "files": [
      "**/*",
      "!dist",
      "!node_modules",
      "!package-source.sh",
      "!build.bat",
      "!RealDebridStreamer-Source.zip",
      "!RealDebridStreamer-Source"
    ]
  }
}
